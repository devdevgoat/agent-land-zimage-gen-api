# Model + memory mode (see README / AGENTS.md):
#   z-image-turbo-bf16-te4 + OFFLOAD=none   fastest, ~14-18 GB VRAM (default)
#   z-image-turbo-q4       + OFFLOAD=none   ~8.5 GB, ~1.6x slower per step
#   z-image-turbo-q3       + OFFLOAD=model  smallest, slowest (shares a crowded GPU)
# DEFAULT_MODEL=z-image-turbo-bf16-te4
# OFFLOAD=none
