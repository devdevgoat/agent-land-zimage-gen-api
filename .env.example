# ============================================================================
# agent-land-zimage-gen-api: every setting you might change lives here.
#
#   cp .env.example .env               # or: python scripts/configure.py   (detects the GPU, writes .env)
#   python scripts/download_models.py  # optional: pre-download the model .env selects
#   docker compose up -d --build       # builds and starts
#
# compose.yaml reads only these variables; you shouldn't need to edit it.
# ============================================================================

# --- Model and memory mode ------------------------------------------------------
# Pick by free GPU memory (measured on an RTX 4090; see BENCHMARKS.md):
#   z-image-turbo-bf16-te4 + OFFLOAD=none   ~14 GB idle, ~18 GB peak. Fastest: 2.9 s per 768 px image. (default)
#   z-image-turbo-q4       + OFFLOAD=none   ~8.5 GB. ~1.6x slower per step (4.3 s at 768).
#   z-image-turbo-q3       + OFFLOAD=model  ~6 GB peak, ~0 idle. Slowest (~16.5 s at 768); shares a crowded GPU.
#   z-image-turbo-fp8      + OFFLOAD=none   ~8 GB, nearly bf16 speed, but LoRAs fail (no pixel-art style).
#   z-image-turbo          + OFFLOAD=none   everything bf16, ~21 GB+. Not tested.
# OFFLOAD: none = weights stay on the GPU (fast); model = each part moves to the GPU only while it runs.
DEFAULT_MODEL=z-image-turbo-bf16-te4
OFFLOAD=none

# --- GPU ----------------------------------------------------------------------
# Which GPU(s) the container sees: "all", or an index / UUID from `nvidia-smi -L`.
IMAGE_GEN_GPU=all
# Base image. Its CUDA version must be <= the driver's ("CUDA Version" in nvidia-smi).
#   pytorch/pytorch:2.9.1-cuda13.0-cudnn9-runtime   driver CUDA >= 13.0 (untested here)
#   pytorch/pytorch:2.9.1-cuda12.8-cudnn9-runtime   driver CUDA >= 12.8 (tested; needed for RTX 50xx)
#   pytorch/pytorch:2.9.1-cuda12.6-cudnn9-runtime   driver CUDA 12.6-12.7 (untested here)
PYTORCH_IMAGE=pytorch/pytorch:2.9.1-cuda12.8-cudnn9-runtime

# --- Network ------------------------------------------------------------------
IMAGE_GEN_PORT=8000
# 0.0.0.0 = reachable on the LAN (needs a firewall rule on Windows); 127.0.0.1 = this machine only.
IMAGE_GEN_BIND=0.0.0.0
# Empty = no authentication (LAN-only). Set to require "Authorization: Bearer <token>"
# on every endpoint except /health and /usage.
API_TOKEN=

# --- Storage ------------------------------------------------------------------
# Hugging Face cache on the host (13-21 GB for one model; more if you try several).
HF_CACHE_DIR=./hf-cache

# --- Limits and behaviour -----------------------------------------------------
MAX_SIDE=1024
MAX_STEPS=50
# Per GPU job. A job stuck HANG_GRACE_SECONDS past this restarts the service.
JOB_TIMEOUT_SECONDS=120
HANG_GRACE_SECONDS=60
QUEUE_MAX=8
MAX_IMAGE_MB=10
# LoRAs listed by GET /models (comma-separated Hugging Face repo ids).
LORAS=tarn59/pixel_art_style_lora_z_image_turbo
# If set (comma-separated), only these LoRA repos may be loaded by callers.
LORA_ALLOWLIST=

# --- Docker names ---------------------------------------------------------------
# Change these to run a second copy side by side (e.g. for testing on another port).
COMPOSE_PROJECT_NAME=zimage-gen
IMAGE_GEN_CONTAINER_NAME=image-gen
